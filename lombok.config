# Root of the Lombok config tree for this project.
config.stopBubbling = true

# Copy @JsonProperty from a field onto Lombok's generated accessors and constructor
# parameters. Without this, a `boolean isClient` field annotated @JsonProperty("isClient")
# still gets a plain `isClient()` getter, which Jackson reads as a separate "client"
# property — so the payload carries both "isClient" and "client". Jackson 2.21 surfaced
# this; CollectionFlagSerializationTest locks the wire names against it.
lombok.copyableAnnotations += com.fasterxml.jackson.annotation.JsonProperty
